# Copia questo file come ".env" e metti i valori veri.
# Il file .env NON va su GitHub (è nel .gitignore).

# password del database Supabase (Project Settings -> Database)
DB_PASSWORD=metti-qui-la-password

# segreto per firmare i token: almeno 32 caratteri, uguale per tutto il gruppo
JWT_SECRET=metti-qui-una-stringa-lunga-almeno-32-caratteri
